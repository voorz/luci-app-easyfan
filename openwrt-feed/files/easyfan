config easyfan 'settings'
	option enabled '1'
	option thermal_file 'auto'
	option fan_file 'auto'
	option temp_div '1000'
	option interval '5'
	option enable_file 'auto'
	option debug '0'

	# Three-stage speed control (percentage)
	option speed_idle '10'
	option temp_normal '30'
	option speed_normal '30'
	option temp_mid '35'
	option speed_mid '50'
	option temp_full '40'
	option speed_full '100'

	# Safety
	option hysteresis '2'
	option fail_safe_speed '100'
	option exit_speed '100'
